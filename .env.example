# Postgres connection string.
# Local example:
#   postgresql://postgres:postgres@localhost:5432/estimation
# Vercel Postgres / Neon will provide this automatically as POSTGRES_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estimation

# Vercel Postgres sets POSTGRES_URL. The app reads POSTGRES_URL first, then DATABASE_URL.
# POSTGRES_URL=

# Required in production to call POST /api/init-db (sent as X-Init-DB-Secret header).
# Generate a long random value, e.g.: openssl rand -hex 32
# INIT_DB_SECRET=
